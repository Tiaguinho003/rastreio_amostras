// POST /clients/:id/units. Cache (scope, key) -> resposta da 1a chamada.
// TTL 24h (D2: cleanup deferido). Header opcional (C1).
model IdempotencyRecord {
  id           String   @id @db.Uuid
  scope        String
  key          String
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(6)

  @@unique([scope, key], map: "uq_idempotency_scope_key")
  @@index([expiresAt], map: "idx_idempotency_expires")
  @@map("idempotency_record")
}

// Informe de visita — envio do formulario do prospector (1 row por envio,
// ilimitado por usuario). Snapshot do que foi respondido: imutavel via API
// EXCETO o trio de vinculo curado (clientId/linkedByUserId/linkedAt, ver
// abaixo); DELETE e admin-qualquer ou autor-proprio. userId e createdAt sao
// carimbados no servidor, nunca vindos do client.
// clientKind e DECLARACAO do autor ("Ja e cliente" / "Cliente novo"), sem
// lookup no banco: new_client_name (obrigatorio) + cidade/telefone opcionais
// sao capturados em texto livre nos DOIS kinds. O vinculo real com o
// cadastro e CURADORIA posterior (linkVisitReportClient, ADMIN/CADASTRO no
// /resumo): clientId setado/trocado/removido com linkedByUserId+linkedAt
// auditando o vinculo ATUAL (null = aguardando vinculo). Compat: payload
// legado EXISTING+clientId (fila offline antiga) nasce "born-linked"
// (clientId setado na criacao, linked_* null).
// sellsToWhom e texto livre, presente apenas quando sellsCurrently=true.
// capturedAt: hora local do preenchimento informada pelo aparelho quando o
// envio passou pela fila offline (null = envio online direto). createdAt
// segue sendo o "recebido em" carimbado pelo servidor.
model VisitReport {
  id                      String             @id @db.Uuid
  userId                  String             @map("user_id") @db.Uuid
  clientKind              VisitClientKind    @map("client_kind")
  clientId                String?            @map("client_id") @db.Uuid
  newClientName           String?            @map("new_client_name")
  // Coluna GERADA pelo banco (LOWER + immutable_unaccent de
  // new_client_name) — busca acento-insensitive; nunca escrever por aqui.
  newClientNameNormalized String?            @map("new_client_name_normalized") @db.Text
  newClientCity           String?            @map("new_client_city")
  newClientPhone          String?            @map("new_client_phone")
  farmSize                VisitFarmSize      @map("farm_size")
  farmSizeNotes           String?            @map("farm_size_notes")
  interestLevel           VisitInterestLevel @map("interest_level")
  interestNotes           String?            @map("interest_notes")
  sellsCurrently          Boolean            @map("sells_currently")
  sellsToWhom             String?            @map("sells_to_whom")
  generalNotes            String?            @map("general_notes")
  capturedAt              DateTime?          @map("captured_at") @db.Timestamptz(6)
  linkedByUserId          String?            @map("linked_by_user_id") @db.Uuid
  linkedAt                DateTime?          @map("linked_at") @db.Timestamptz(6)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User    @relation("VisitReportAuthor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  linkedBy User?   @relation("VisitReportLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt, id], map: "idx_visit_report_created_id")
  @@index([userId, createdAt], map: "idx_visit_report_user_created")
  @@index([clientId], map: "idx_visit_report_client")
  @@index([linkedByUserId], map: "idx_visit_report_linked_by")
  @@map("visit_report")
}

// Visita do COMERCIAL (formulario "Visitas" da pagina /informe do papel
// COMMERCIAL — diferente do informe do prospector). 1 row por envio, sem
// update via API; user_id/created_at carimbados no servidor. Identificacao
// do cliente identica ao visit_report (client_kind EXISTING/NEW). Sem
// captured_at: o formulario do comercial nao tem fila offline.
model CommercialVisit {
  id                      String                 @id @db.Uuid
  userId                  String                 @map("user_id") @db.Uuid
  clientKind              VisitClientKind        @map("client_kind")
  clientId                String?                @map("client_id") @db.Uuid
  newClientName           String?                @map("new_client_name")
  // Coluna GERADA pelo banco (LOWER + immutable_unaccent de
  // new_client_name) — busca acento-insensitive; nunca escrever por aqui.
  newClientNameNormalized String?                @map("new_client_name_normalized") @db.Text
  newClientCity           String?                @map("new_client_city")
  newClientPhone          String?                @map("new_client_phone")
  // Trio de vinculo CURADO (so quando clientKind=NEW; ver linkCommercialVisitClient).
  // Espelha visit_report: linked_by_user_id (quem curou) + linked_at (quando).
  // EXISTING e born-linked (clientId na criacao) e NAO e curavel.
  linkedByUserId          String?                @map("linked_by_user_id") @db.Uuid
  linkedAt                DateTime?              @map("linked_at") @db.Timestamptz(6)
  reason                  CommercialVisitReason
  reasonNotes             String?                @map("reason_notes")
  outcome                 CommercialVisitOutcome
  outcomeNotes            String?                @map("outcome_notes")
  generalNotes            String?                @map("general_notes")
  createdAt               DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  user     User    @relation("CommercialVisitAuthor", fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  client   Client? @relation(fields: [clientId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  linkedBy User?   @relation("CommercialVisitLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([createdAt, id], map: "idx_commercial_visit_created_id")
  @@index([userId, createdAt], map: "idx_commercial_visit_user_created")
  @@index([clientId], map: "idx_commercial_visit_client")
  @@index([linkedByUserId], map: "idx_commercial_visit_linked_by")
  @@map("commercial_visit")
}

// Relatorio SEMANAL do comercial (formulario "Relatorio" da pagina
// /informe). Semana de referencia computada pelo SERVIDOR (segunda BRT,
// date-only) — o body nunca decide a semana. UNIQUE (user_id, week_start)
// garante no maximo 1 relatorio por usuario por semana (violacao -> 409).
model WeeklyReport {
  id           String   @id @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  weekStart    DateTime @map("week_start") @db.Date
  summary      String
  difficulties String?
  nextWeekPlan String?  @map("next_week_plan")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, weekStart], map: "uq_weekly_report_user_week")
  @@index([createdAt, id], map: "idx_weekly_report_created_id")
  @@index([userId, createdAt], map: "idx_weekly_report_user_created")
  @@map("weekly_report")
}

// Marcador do lembrete de relatorio semanal ja enviado (push) — garante
// NO MAXIMO 1 lembrete por usuario por semana, independente de qual regra
// disparou (ultimo relatorio > 6d12h OU sexta 17:00 BRT sem relatorio).
// Ver sendWeeklyReportReminders em commercial-forms-service.js.
model WeeklyReportReminder {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  weekStart DateTime @map("week_start") @db.Date
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([userId, weekStart], map: "uq_weekly_report_reminder_user_week")
  @@map("weekly_report_reminder")
}

// Inscricao de Web Push de UM aparelho/navegador de UM usuario (N aparelhos
// por usuario = N rows). endpoint e a URL unica do push service do navegador
// (Apple/Google); p256dh+auth sao as chaves de criptografia da inscricao.
// Upsert por endpoint: se outro usuario ativar no mesmo aparelho, a inscricao
// troca de dono. Rows somem no desativar (Perfil) ou quando o push service
// responde 404/410 (inscricao expirada/revogada — prune no envio).
model PushSubscription {
  id        String   @id @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  endpoint  String   @unique(map: "uq_push_subscription_endpoint")
  p256dh    String
  auth      String
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId], map: "idx_push_subscription_user")
  @@map("push_subscription")
}
